/ {
	aliases {
		led5180 = &led1;
		button5180 = &button0;
	};
};

#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
&i2c1 {
	status = "okay";

	pinctrl-0 = <&bme280_i2c1_default>;
	pinctrl-1 = <&bme280_i2c1_sleep>;
	pinctrl-names = "default", "sleep";

	bme280_5180: bme280@77 {
		compatible = "i2c-device";
		reg = <0x77>;
		status = "okay";
	};
};

&pinctrl {
	bme280_i2c1_default: bme280_i2c1_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 14)>,
				<NRF_PSEL(TWIM_SDA, 1, 15)>;
		};
	};

	bme280_i2c1_sleep: bme280_i2c1_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 14)>,
				<NRF_PSEL(TWIM_SDA, 1, 15)>;
			low-power-enable;
		};
	};
};
